// arrays.lum — arrays and higher-order operations
// Demonstrates: arrays, push/rest/first, recursive map

let map = fn(arr, f) {
  if (len(arr) == 0) {
    return []
  }
  return push(map(rest(arr), f), f(first(arr)))
}

let double = fn(x) { x * 2 }
let nums   = [1, 2, 3, 4, 5]

print("Original:")
print(nums[0])
print(nums[1])
print(nums[2])

print("Doubled via map:")
let doubled = map(nums, double)
print(doubled[0])
print(doubled[1])
print(doubled[2])

// Array length
print("Length: " + str(len(nums)))
